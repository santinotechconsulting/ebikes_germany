# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted (used for sitemap, canonical URLs, and payment redirects).
APP_URL="http://localhost:3000"

# GOOGLE_MAPS_API_KEY / VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for interactive showroom map.
VITE_GOOGLE_MAPS_API_KEY=""

# STRIPE_SECRET_KEY: Optional Stripe secret key for live/test server-side payment intents.
STRIPE_SECRET_KEY=""

# MOLLIE_API_KEY: Optional Mollie API key for Klarna, SEPA, PayPal & Card checkout in Germany.
MOLLIE_API_KEY=""

# RESEND_API_KEY: Optional Resend API key for transactional order & enquiry emails.
RESEND_API_KEY=""
EMAIL_FROM="E-MOTION BIKES <service@emotion-bikes.example>"
